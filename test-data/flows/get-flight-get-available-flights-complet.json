{
  "id": "get-flight-get-available-flights-complet",
  "title": "Completed flights are not offered",
  "source": "staged scenario",
  "why": "A flight already flown must not appear as available.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2019,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-completed",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-10-22T09:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-10-22T09:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-10-22T00:00:00Z",
        "FlightNumber": "FL140",
        "IsDeleted": false,
        "Price": 250.0,
        "Status": "Completed",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-flights for JFK to LAX on 2026-10-22 (yesterday)."
    }
  ],
  "expect": [
    "FL140 is not returned; the list is empty."
  ]
}
