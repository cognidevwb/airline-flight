{
  "id": "post-flight-reserve-seat-reserve-first-c",
  "title": "Reserve first class seat on a flying flight",
  "source": "staged scenario",
  "why": "Checks whether a flight already in the air still accepts reservations as the code intends",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2021,
        "Model": "A350",
        "Name": "Skyliner 3",
        "Version": 1
      }
    },
    {
      "ref": "airport-dep",
      "table": "Airport",
      "values": {
        "Address": "Singapore",
        "Code": "SIN",
        "IsDeleted": false,
        "Name": "Changi",
        "Version": 1
      }
    },
    {
      "ref": "airport-arr",
      "table": "Airport",
      "values": {
        "Address": "Sydney",
        "Code": "SYD",
        "IsDeleted": false,
        "Name": "Sydney",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-arr",
        "ArriveDate": "2026-10-23T14:00:00Z",
        "DepartureAirportId": "airport-dep",
        "DepartureDate": "2026-10-23T06:00:00Z",
        "DurationMinutes": 480,
        "FlightDate": "2026-10-23T00:00:00Z",
        "FlightNumber": "FL300",
        "IsDeleted": false,
        "Price": 900.0,
        "Status": "Flying",
        "Version": 1
      }
    },
    {
      "ref": "seat-1",
      "table": "Seat",
      "values": {
        "Class": "FirstClass",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "1A",
        "Type": "Window",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST /flight/reserve-seat with FlightId of flight-1 and SeatNumber 1A"
    }
  ],
  "expect": [
    "Success; seat 1A is reserved even though the flight status is Flying"
  ]
}
