{
  "id": "post-flight-reserve-seat-same-seat-canno",
  "title": "Same seat cannot be reserved twice",
  "source": "staged scenario",
  "why": "Checks double-booking protection",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2018,
        "Model": "A320",
        "Name": "Skyliner 9",
        "Version": 1
      }
    },
    {
      "ref": "airport-dep",
      "table": "Airport",
      "values": {
        "Address": "London",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-arr",
      "table": "Airport",
      "values": {
        "Address": "New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-arr",
        "ArriveDate": "2026-11-10T16:30:00Z",
        "DepartureAirportId": "airport-dep",
        "DepartureDate": "2026-11-10T09:00:00Z",
        "DurationMinutes": 450,
        "FlightDate": "2026-11-10T00:00:00Z",
        "FlightNumber": "FL100",
        "IsDeleted": false,
        "Price": 220.0,
        "Status": "Unknown",
        "Version": 1
      }
    },
    {
      "ref": "seat-1",
      "table": "Seat",
      "values": {
        "Class": "Economy",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "12A",
        "Type": "Window",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Send POST /flight/reserve-seat for FlightId of flight-1 and SeatNumber 12A, then send the identical request again"
    }
  ],
  "expect": [
    "First succeeds; second is rejected as seat already reserved and the first booking is unchanged"
  ]
}
