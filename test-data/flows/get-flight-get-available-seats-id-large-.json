        "SeatNumber": "1A..~55J (500 seats, mixed classes and types)",
        "Type": "Window"
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Book 20 of the 500 seats, then GET /flight/get-available-seats/{flight-1 Id}"
    }
  ],
  "expect": [
    "200 with all 480 open seats in one list"
  ]
