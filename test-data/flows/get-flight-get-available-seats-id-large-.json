        "Model": "A380",
        "Name": "Skyliner 13"
      }
    },
    {
      "ref": "airport-1",
      "table": "Airport",
      "values": {
        "Address": "London",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow"
      }
    },
    {
      "ref": "airport-2",
      "table": "Airport",
      "values": {
        "Address": "Dubai",
        "Code": "DXB",
        "IsDeleted": false,
        "Name": "Dubai Intl"
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-2",
        "ArriveDate": "2026-12-08T23:50:00Z",
        "DepartureAirportId": "airport-1",
        "DepartureDate": "2026-12-08T14:00:00Z",
