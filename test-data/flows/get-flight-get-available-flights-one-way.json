{
  "id": "get-flight-get-available-flights-one-way",
  "title": "One-way search between two airports on a date",
  "source": "staged scenario",
  "why": "Confirms the basic search returns a matching flight with its number, status and price.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "CreatedAt": "2026-01-01T00:00:00Z",
        "CreatedBy": 1,
        "IsDeleted": false,
        "ManufacturingYear": 2018,
        "Model": "737-800",
        "Name": "Boeing 737-800",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "CreatedAt": "2026-01-01T00:00:00Z",
        "CreatedBy": 1,
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "CreatedAt": "2026-01-01T00:00:00Z",
        "CreatedBy": 1,
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T09:45:00Z",
        "CreatedAt": "2026-10-01T00:00:00Z",
        "CreatedBy": 1,
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-06T09:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FL100",
        "IsDeleted": false,
        "Price": 250.0,
        "Status": "Flying",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-flights with departure airport flight-1's JFK, arrival airport LAX, and date 2026-11-06 (today+14)."
    }
  ],
  "expect": [
    "One result: FL100, JFK to LAX, status Flying, price 250.00."
  ]
}
