{
  "id": "get-flight-get-available-flights-duplica",
  "title": "Duplicate flight number on the same date",
  "source": "staged scenario",
  "why": "Shows how search behaves, and whether the data is rejected, when two flights share a number on one date.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2019,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-original",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T09:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-06T09:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FL100",
        "IsDeleted": false,
        "Price": 250.0,
        "Status": "Flying",
        "Version": 1
      }
    },
    {
      "ref": "flight-duplicate",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T15:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-06T15:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FL100",
        "IsDeleted": false,
        "Price": 275.0,
        "Status": "Flying",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Insert the second FL100 for the same FlightDate, then GET /flight/get-available-flights for JFK to LAX on 2026-11-06."
    }
  ],
  "expect": [
    "The duplicate is rejected on insert. If it is stored anyway, search must still respond without error and the duplicate is flagged as a defect."
  ]
}
