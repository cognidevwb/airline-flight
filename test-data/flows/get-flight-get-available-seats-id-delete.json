        "ManufacturingYear": 2013,
        "Model": "A320",
        "Name": "Skyliner 9"
      }
    },
    {
      "ref": "airport-1",
      "table": "Airport",
      "values": {
        "Address": "Zurich",
        "Code": "ZRH",
        "IsDeleted": false,
        "Name": "Zurich"
      }
    },
    {
      "ref": "airport-2",
      "table": "Airport",
      "values": {
        "Address": "Brussels",
        "Code": "BRU",
        "IsDeleted": false,
        "Name": "Brussels"
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-2",
        "ArriveDate": "2026-12-04T11:20:00Z",
