        "IsDeleted": true,
        "SeatNumber": "7C",
        "Type": "Aisle"
      }
    },
    {
      "ref": "seat-7D",
      "table": "Seat",
      "values": {
        "Class": "Economy",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "7D",
        "Type": "Aisle"
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-seats/{flight-1 Id}"
