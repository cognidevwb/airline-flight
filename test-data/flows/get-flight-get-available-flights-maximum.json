{
  "id": "get-flight-get-available-flights-maximum",
  "title": "Maximum length flight number and price",
  "source": "staged scenario",
  "why": "Checks that values at the column limits are stored and returned unchanged.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2019,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-max",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T09:50:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-06T09:00:00Z",
        "DurationMinutes": 50,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FLAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "IsDeleted": false,
        "Price": 9999999999,
        "Status": "Flying",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-flights for JFK to LAX on 2026-11-06."
    }
  ],
  "expect": [
    "The flight is returned with the full 50-character number, price 9999999999 and duration 50, none truncated or rounded."
  ]
}
