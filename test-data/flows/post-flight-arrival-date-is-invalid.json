{
  "id": "post-flight-arrival-date-is-invalid",
  "title": "Arrival date is invalid",
  "source": "staged scenario",
  "why": "Confirms arrival must be a real date and not before departure.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2015,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, NY",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-bos",
      "table": "Airport",
      "values": {
        "Address": "Boston, MA",
        "Code": "BOS",
        "IsDeleted": false,
        "Name": "Logan International",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST …/flight with DepartureDate 2026-11-10T10:00 and ArriveDate 2026-11-10T09:00; then again with ArriveDate left at 0001-01-01"
    }
  ],
  "expect": [
    "Both rejected with a validation error on ArriveDate."
  ]
}
