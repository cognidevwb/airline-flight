{
  "id": "post-flight-reserve-seat-seat-number-doe",
  "title": "Seat number does not match the seat",
  "source": "staged scenario",
  "why": "Checks the seat id and seat number are cross-validated rather than one silently winning",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2018,
        "Model": "A320",
        "Name": "Skyliner 19",
        "Version": 1
      }
    },
    {
      "ref": "airport-dep",
      "table": "Airport",
      "values": {
        "Address": "London",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-arr",
      "table": "Airport",
      "values": {
        "Address": "New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-arr",
        "ArriveDate": "2026-11-10T16:30:00Z",
        "DepartureAirportId": "airport-dep",
        "DepartureDate": "2026-11-10T09:00:00Z",
        "DurationMinutes": 450,
        "FlightDate": "2026-11-10T00:00:00Z",
        "FlightNumber": "FL100",
        "IsDeleted": false,
        "Price": 220.0,
        "Status": "Unknown",
        "Version": 1
      }
    },
    {
      "ref": "seat-1",
      "table": "Seat",
      "values": {
        "Class": "Economy",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "12A",
        "Type": "Window",
        "Version": 1
      }
    },
    {
      "ref": "seat-2",
      "table": "Seat",
      "values": {
        "Class": "Economy",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "12B",
        "Type": "Middle",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST /flight/reserve-seat with FlightId of flight-1, the SeatId of seat-1 (12A) and SeatNumber 12B"
