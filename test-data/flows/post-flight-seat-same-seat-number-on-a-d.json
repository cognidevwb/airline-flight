      "values": {
        "Address": "Longford TW6",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-2",
      "table": "Airport",
      "values": {
        "Address": "Queens NY 11430",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-ba100",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-2",
        "ArriveDate": "2026-12-01T16:00:00Z",
        "DepartureAirportId": "airport-1",
        "DepartureDate": "2026-12-01T09:00:00Z",
        "DurationMinutes": 420,
        "FlightDate": "2026-12-01T00:00:00Z",
        "FlightNumber": "BA100",
        "IsDeleted": false,
        "Price": 450,
        "Status": "Flying",
        "Version": 1
      }
    },
    {
      "ref": "flight-ba200",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-1",
        "ArriveDate": "2026-12-02T16:00:00Z",
        "DepartureAirportId": "airport-2",
        "DepartureDate": "2026-12-02T09:00:00Z",
        "DurationMinutes": 400,
        "FlightDate": "2026-12-02T00:00:00Z",
        "FlightNumber": "BA200",
        "IsDeleted": false,
        "Price": 430,
        "Status": "Flying",
        "Version": 1
