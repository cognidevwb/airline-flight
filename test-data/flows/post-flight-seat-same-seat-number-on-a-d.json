{
  "id": "post-flight-seat-same-seat-number-on-a-d",
  "title": "Same seat number on a different flight is allowed",
  "source": "staged scenario",
  "why": "Shows seat-number uniqueness is scoped to one flight.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
