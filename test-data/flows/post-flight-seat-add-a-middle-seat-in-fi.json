{
  "id": "post-flight-seat-add-a-middle-seat-in-fi",
  "title": "Add a middle seat in first class",
  "source": "staged scenario",
  "why": "Shows seats can be added to a flight whose status is Delay.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2015,
        "Model": "737-800",
        "Name": "G-ABCD",
        "Version": 1
      }
    },
    {
      "ref": "airport-1",
      "table": "Airport",
      "values": {
        "Address": "Longford TW6",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-2",
      "table": "Airport",
      "values": {
        "Address": "Queens NY 11430",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-2",
        "ArriveDate": "2026-12-01T16:00:00Z",
        "DepartureAirportId": "airport-1",
        "DepartureDate": "2026-12-01T09:00:00Z",
        "DurationMinutes": 420,
        "FlightDate": "2026-12-01T00:00:00Z",
        "FlightNumber": "BA100",
        "IsDeleted": false,
        "Price": 450,
        "Status": "Delay",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST /flight/seat with SeatNumber 1B, Type Middle, Class FirstClass, FlightId flight-1"
    }
  ],
  "expect": [
    "Seat 1B is created as Middle/FirstClass; the Delay status does not block it."
  ]
}
