        "SeatNumber": "12A",
        "Type": "Window",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Passenger A reserves 12A on FL100 via POST /flight/reserve-seat, then passenger B sends the same request for 12A"
