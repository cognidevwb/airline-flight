{
  "id": "post-flight-reserve-seat-seat-already-ta",
  "title": "Seat already taken",
  "source": "staged scenario",
  "why": "Confirms a seat booked by another passenger cannot be taken by a second one",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
