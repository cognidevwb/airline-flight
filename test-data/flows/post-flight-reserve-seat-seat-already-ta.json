      "values": {
        "Address": "London",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-arr",
      "table": "Airport",
      "values": {
        "Address": "New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-arr",
        "ArriveDate": "2026-11-10T16:30:00Z",
        "DepartureAirportId": "airport-dep",
        "DepartureDate": "2026-11-10T09:00:00Z",
