{
  "id": "post-flight-seat-seat-already-exists-on-",
  "title": "Seat already exists on the flight",
  "source": "staged scenario",
  "why": "Confirms duplicate seat numbers on one flight are refused.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2015,
        "Model": "737-800",
        "Name": "G-ABCD",
        "Version": 1
      }
    },
    {
      "ref": "airport-1",
      "table": "Airport",
      "values": {
        "Address": "Longford TW6",
        "Code": "LHR",
        "IsDeleted": false,
        "Name": "Heathrow",
        "Version": 1
      }
    },
    {
      "ref": "airport-2",
      "table": "Airport",
      "values": {
        "Address": "Queens NY 11430",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "JFK",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-2",
        "ArriveDate": "2026-12-01T16:00:00Z",
        "DepartureAirportId": "airport-1",
        "DepartureDate": "2026-12-01T09:00:00Z",
        "DurationMinutes": 420,
        "FlightDate": "2026-12-01T00:00:00Z",
        "FlightNumber": "BA100",
        "IsDeleted": false,
        "Price": 450,
        "Status": "Flying",
        "Version": 1
      }
    },
    {
      "ref": "seat-12a",
      "table": "Seat",
      "values": {
        "Class": "Economy",
        "FlightId": "flight-1",
        "IsDeleted": false,
        "SeatNumber": "12A",
        "Type": "Window",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST /flight/seat with SeatNumber 12A, Type Window, Class Economy, FlightId flight-1"
    }
  ],
  "expect": [
    "Request is rejected with a duplicate-seat error; flight-1 still has exactly one seat 12A."
  ]
}
