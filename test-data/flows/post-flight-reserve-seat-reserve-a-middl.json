        "Name": "Skyliner 4",
        "Version": 1
      }
    },
    {
      "ref": "airport-dep",
      "table": "Airport",
      "values": {
        "Address": "Amsterdam",
        "Code": "AMS",
        "IsDeleted": false,
        "Name": "Schiphol",
        "Version": 1
      }
    },
    {
      "ref": "airport-arr",
      "table": "Airport",
      "values": {
        "Address": "Madrid",
        "Code": "MAD",
        "IsDeleted": false,
        "Name": "Madrid Barajas",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
