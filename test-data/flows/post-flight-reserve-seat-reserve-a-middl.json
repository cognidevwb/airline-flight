        "SeatNumber": "22B",
        "Type": "Middle",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST /flight/reserve-seat with FlightId of flight-1 and SeatNumber 22B"
    }
  ],
  "expect": [
    "Success; seat 22B is reserved on the delayed flight"
