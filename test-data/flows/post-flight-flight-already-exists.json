{
  "id": "post-flight-flight-already-exists",
  "title": "Flight already exists",
  "source": "staged scenario",
  "why": "Checks duplicate protection on FlightNumber plus date.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2015,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, NY",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-bos",
      "table": "Airport",
      "values": {
        "Address": "Boston, MA",
        "Code": "BOS",
        "IsDeleted": false,
        "Name": "Logan International",
        "Version": 1
      }
    },
    {
      "ref": "flight-1",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-bos",
        "ArriveDate": "2026-11-10T08:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-10T08:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-10T00:00:00Z",
        "FlightNumber": "FL-1001",
        "IsDeleted": false,
        "Price": 9,
        "Status": "Flying",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST …/flight again with FlightNumber FL-1001 and FlightDate 2026-11-10, same aircraft and route"
    }
  ],
  "expect": [
    "Rejected with a conflict or already-exists error; only one FL-1001 for that date remains."
  ]
}
