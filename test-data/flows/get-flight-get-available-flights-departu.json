{
  "id": "get-flight-get-available-flights-departu",
  "title": "Departure date missing or invalid",
  "source": "staged scenario",
  "why": "Checks that a default 0001-01-01 departure is not accepted as a real schedule.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2019,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-no-departure",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T09:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "0001-01-01T00:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FL220",
        "IsDeleted": false,
        "Price": 250.0,
        "Status": "Flying",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Try to create the flight with DepartureDate 0001-01-01, then GET /flight/get-available-flights for JFK to LAX on 2026-11-06."
    }
  ],
  "expect": [
    "The insert is rejected with a departure date validation error, and FL220 is not returned in search."
  ]
}
