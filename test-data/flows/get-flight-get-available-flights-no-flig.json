        "Name": "San Francisco International",
        "Version": 1
      }
    },
    {
      "ref": "airport-ord",
      "table": "Airport",
      "values": {
        "Address": "Chicago, IL",
        "Code": "ORD",
        "IsDeleted": false,
        "Name": "O'Hare International",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-flights from SFO to ORD on 2026-11-06."
