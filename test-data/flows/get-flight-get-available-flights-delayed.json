{
  "id": "get-flight-get-available-flights-delayed",
  "title": "Delayed flight is still listed with its status",
  "source": "staged scenario",
  "why": "A delay should not hide a flight; travelers need to see the status and new time.",
  "setup": [
    {
      "ref": "aircraft-1",
      "table": "Aircraft",
      "values": {
        "IsDeleted": false,
        "ManufacturingYear": 2019,
        "Model": "737-800",
        "Name": "Boeing 737",
        "Version": 1
      }
    },
    {
      "ref": "airport-jfk",
      "table": "Airport",
      "values": {
        "Address": "Queens, New York",
        "Code": "JFK",
        "IsDeleted": false,
        "Name": "John F. Kennedy International",
        "Version": 1
      }
    },
    {
      "ref": "airport-lax",
      "table": "Airport",
      "values": {
        "Address": "Los Angeles, CA",
        "Code": "LAX",
        "IsDeleted": false,
        "Name": "Los Angeles International",
        "Version": 1
      }
    },
    {
      "ref": "flight-delayed",
      "table": "Flight",
      "values": {
        "AircraftId": "aircraft-1",
        "ArriveAirportId": "airport-lax",
        "ArriveDate": "2026-11-06T12:45:00Z",
        "DepartureAirportId": "airport-jfk",
        "DepartureDate": "2026-11-06T12:00:00Z",
        "DurationMinutes": 45,
        "FlightDate": "2026-11-06T00:00:00Z",
        "FlightNumber": "FL170",
        "IsDeleted": false,
        "Price": 250.0,
        "Status": "Delay",
        "Version": 2
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /flight/get-available-flights for JFK to LAX on 2026-11-06. The flight was originally scheduled for 09:00 and its DepartureDate is shifted +3 hours to 12:00."
    }
  ],
  "expect": [
    "FL170 is returned with status Delay and departure 12:00."
  ]
}
